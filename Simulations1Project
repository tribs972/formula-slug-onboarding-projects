import numpy as np


@dataclass
class State:
    xpos: float
    ypos: float
    xvel: float
    time: float

deltaT = 0.75
#this does not respresent time, it repsresent how often we will see a change in animation, so every 1 sec.

def step (state:State) -> State:
    new_xpos = state.xpos + state.xvel * deltaT

    drag = 0.5 * 1.1 * 1.225 * state.xvel ** 2
    mass = 800
    if state.time <= 10: # the acceleration if statement must be used BEFORE we call acceleration in the equation below
        acceleration = 2 - (drag/mass)
    else: 
        acceleration = -4 - (drag/mass)
    new_xvel = state.xvel + acceleration * deltaT
    '''no state.acceleration because acceleration is not in state class, ALSO dont use state.time, we are using deltaT,
    state.time is how much time has passes in total, but the detlaT is each time position which will help us calculate
      the velocity at each position'''
    if new_xvel < 0:
        new_xvel = 0 #this is needed to the car stops after the velocity is 0, if not it will start to go backwards,also we put the if statement after the equation this time, because we start positive, we put the other if statement before the equation because it just logically made sense
    
    new_time = state.time + deltaT # how much time has passed

    newState = State (
        xpos = new_xpos,
        ypos = state.ypos,
        xvel = new_xvel,
        time = new_time
    )

    return newState


